# Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used for evidence-submission uploads (see lib/supabase.sql for setup)
SUPABASE_STORAGE_BUCKET=evidence-uploads

# Your deployed site's URL, used to build correct absolute links in social share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moderation console (/admin). ADMIN_PASSWORD can review records; SUPERADMIN_PASSWORD
# is required for advert approval and management. Generate passwords in PowerShell:
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
ADMIN_PASSWORD=
SUPERADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional anti-spam protection on /submit (recommended before going live).
# Get both free from https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_ prefix is required on the site key so the browser widget can read it —
# TURNSTILE_SECRET_KEY has no prefix on purpose: it must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Follow notification delivery (used by the hourly Vercel Cron worker).
CRON_SECRET=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
