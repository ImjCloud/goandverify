# Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used for evidence-submission uploads (see lib/supabase.sql for setup)
SUPABASE_STORAGE_BUCKET=evidence-uploads

# Your deployed site's URL, used to build correct absolute links in social share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moderation console (/admin) — single shared password gate.
# Generate a strong ADMIN_SESSION_SECRET with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional anti-spam / upload protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
