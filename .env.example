# Supabase project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket used for evidence-submission uploads (see lib/supabase.sql for setup)
SUPABASE_STORAGE_BUCKET=evidence-uploads

# Your deployed site's URL, used to build correct absolute links in social share previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Moderation console (/admin). ADMIN_PASSWORD can review records and manage adverts.
# SUPERADMIN_PASSWORD is reserved for future higher-risk privileged operations.
# Generate passwords in PowerShell:
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
ADMIN_PASSWORD=
SUPERADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Follow notification delivery (used by the hourly Vercel Cron worker).
CRON_SECRET=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
